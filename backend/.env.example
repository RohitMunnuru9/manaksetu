# Copy to backend/.env and fill in real values. This example file is committed,
# so nothing in it is a secret and nothing in it may be used to sign tokens.

DATABASE_URL=postgresql+psycopg://manaksetu:manaksetu@db:5432/manaksetu

# Required outside development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. Left unset in development, the application
# generates an ephemeral secret at startup instead of using a known string.
JWT_SECRET=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:3000

# development | production. Anything other than development requires a real
# JWT_SECRET and should disable demonstration accounts.
ENVIRONMENT=development

# Local demonstration accounts. Set to false for any shared deployment.
SEED_DEMO_USERS=true
DEMO_USER_EMAIL=officer@manaksetu.gov.in
DEMO_USER_PASSWORD=ManakSetu@2026

# Local language-model briefing layer. Optional; retrieval and the rule engine
# are unaffected by it. Requires Ollama running with the model pulled.
ENABLE_LLM_EXPLANATIONS=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=45
